DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cordon?schema=public"

# Optional. Raises GitHub API limits for repository metadata and archive downloads.
GITHUB_TOKEN=""

# Optional. Shows real local fixture demonstrations and intentional fixture reset.
CORDON_SUBMISSION_MODE="false"

# Optional operator-enforced registry-only install network. Leave all unset to keep
# quarantine network-disabled. Partial configuration is refused.
CORDON_QUARANTINE_NETWORK=""
CORDON_REGISTRY_PROXY_URL=""
CORDON_QUARANTINE_ALLOWLIST_ENFORCED=""
CORDON_REGISTRY_ALLOWLIST="registry.npmjs.org"
